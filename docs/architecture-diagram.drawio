0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1150" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title2" parent="1" value="&lt;b&gt;Interner Ablauf: Direkter Repository-Zugriff &amp;amp; Dynamic RBAC Management&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#111827;" vertex="1"><mxGeometry x="50" y="25" width="1350" height="35" as="geometry" /></mxCell><mxCell id="subtitle2" parent="1" value="Zeigt den direkten Zugriff ohne Gateway: Pfad A (Policies via Keycloak RBAC) vs. Pfad B (AAS-Datenzugriff via STS-Token-Validierung)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#4b5563;" vertex="1"><mxGeometry x="50" y="58" width="1350" height="20" as="geometry" /></mxCell><mxCell id="c_prov_domain" parent="1" value="&lt;b&gt;Provider Interne Domäne (provider-net) – Direkter Intranet-Zugriff ohne Gateway&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;fillColor=none;strokeColor=#4b5563;verticalAlign=bottom;align=left;spacingLeft=15;spacingBottom=10;fontSize=14;fontStyle=2;fontColor=#374151;" vertex="1"><mxGeometry x="50" y="95" width="1650" height="640" as="geometry" /></mxCell><mxCell id="c_admin_zone" parent="1" value="&lt;b&gt;1. Interne Clients &amp;amp; Workstations&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;strokeWidth=1.5;fillColor=#fbfbfd;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#4b5563;" vertex="1"><mxGeometry x="80" y="135" width="330" height="460" as="geometry" /></mxCell><mxCell id="p2_admin" parent="1" value="&lt;b&gt;Provider Admin / Workstation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;M2M Client: workstation-1&lt;br&gt;User: john.doe / Postman&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#1f2937;arcSize=18;shadow=1;" vertex="1"><mxGeometry x="105" y="180" width="280" height="85" as="geometry" /></mxCell><mxCell id="p2_setup_init" parent="1" value="&lt;b&gt;Security Setup Initializer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Docker Container (setup-entrypoint.sh)&lt;br&gt;Injiziert Basis-Regeln beim Booten&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#1f2937;arcSize=18;shadow=1;" vertex="1"><mxGeometry x="105" y="315" width="280" height="75" as="geometry" /></mxCell><mxCell id="p2_web_ui" parent="1" value="&lt;b&gt;BaSyx AAS Web UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Port 3000 (Vue.js Frontend)&lt;br&gt;Direkte Modell-Inspektion &amp;amp; CRUD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#1f2937;arcSize=18;shadow=1;" vertex="1"><mxGeometry x="105" y="440" width="280" height="85" as="geometry" /></mxCell><mxCell id="c_idp_zone" parent="1" value="&lt;b&gt;2. Policy Identity Authority (PAP)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;strokeWidth=1.5;fillColor=#fbfbfd;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#4b5563;" vertex="1"><mxGeometry x="450" y="135" width="380" height="190" as="geometry" /></mxCell><mxCell id="p2_kc_rbac" parent="1" value="&lt;b&gt;Provider Keycloak RBAC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Port 8085 • Realm: BaSyx&lt;br&gt;Endpoint: /realms/BaSyx/protocol/openid-connect/token&lt;br&gt;Roles: admin, basyx-reader, basyx-updater&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#1f2937;arcSize=18;shadow=1;" vertex="1"><mxGeometry x="475" y="180" width="330" height="115" as="geometry" /></mxCell><mxCell id="c_sec_repo_zone" parent="1" value="&lt;b&gt;3. Security Submodel Repository (PDP / PIP)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;strokeWidth=1.5;fillColor=#fbfbfd;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#4b5563;" vertex="1"><mxGeometry x="870" y="135" width="790" height="220" as="geometry" /></mxCell><mxCell id="p2_sec_sm" parent="1" value="&lt;b&gt;Security Submodel Repo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Port 8086 • BaSyx Submodel Service&lt;br&gt;Submodel ID: SecuritySubmodel&lt;br&gt;&lt;b&gt;Vertraut direkt: Keycloak RBAC (8085)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#1f2937;arcSize=18;shadow=1;" vertex="1"><mxGeometry x="895" y="180" width="340" height="95" as="geometry" /></mxCell><mxCell id="p2_mongo" parent="1" value="&lt;b&gt;BaSyx MongoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Port 27017&lt;br&gt;DB: security-sm&lt;br&gt;Collection: submodels&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1f2937;shadow=1;" vertex="1"><mxGeometry x="1330" y="180" width="290" height="95" as="geometry" /></mxCell><mxCell id="p2_sec_rules_note" parent="1" value="&lt;font style=&quot;font-size:11px;color:#1e3a8a;&quot;&gt;&lt;b&gt;Pfad A (Policy-Verwaltung):&lt;/b&gt; Reiner Intranet-Weg! Läuft zu 100% über Keycloak RBAC (8085) direkt zum Security Submodel (8086). &lt;u&gt;Weder Gateway noch STS beteiligt!&lt;/u&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;strokeWidth=1;align=left;spacingLeft=10;fontSize=11;fontColor=#1e3a8a;" vertex="1"><mxGeometry x="895" y="290" width="725" height="45" as="geometry" /></mxCell><mxCell id="c_aas_zone" parent="1" value="&lt;b&gt;4. AAS Environment Repository &amp;amp; Token-Validierung (PEP)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;strokeWidth=1.5;fillColor=#fbfbfd;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#4b5563;" vertex="1"><mxGeometry x="450" y="365" width="1210" height="230" as="geometry" /></mxCell><mxCell id="p2_sts_prov" parent="1" value="&lt;b&gt;Provider STS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Port 9051 • Spring Boot STS&lt;br&gt;&lt;b&gt;Token Issuer für Provider AAS&lt;/b&gt;&lt;br&gt;(Single-Issuer Lock in BaSyx)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0040ff;strokeWidth=3.5;fontSize=13;fontStyle=1;fontColor=#1f2937;arcSize=18;shadow=1;" vertex="1"><mxGeometry x="475" y="415" width="270" height="95" as="geometry" /></mxCell><mxCell id="p2_aas_env" parent="1" value="&lt;b&gt;Provider AAS Environment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Port 8083 • Eclipse BaSyx 2.0.0 Server&lt;br&gt;Endpoints: /shells &amp;amp; /submodels (FrameAAS, GearAAS)&lt;br&gt;&lt;b&gt;spring.security.oauth2.resourceserver.jwt.issuer-uri=http://provider-sts:9050/sts&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#1f2937;arcSize=18;shadow=1;" vertex="1"><mxGeometry x="810" y="410" width="420" height="105" as="geometry" /></mxCell><mxCell id="p2_constraint_box" parent="1" value="&lt;font style=&quot;font-size:11px;color:#7c2d12;&quot;&gt;&lt;b&gt;Architektur-Besonderheit (Single Issuer Constraint):&lt;/b&gt;&lt;br&gt;Weil die BaSyx AAS aktuell nur &lt;i&gt;einen&lt;/i&gt; Issuer-URI konfiguriert hat (Provider STS), verlangt sie auch bei internen Datenabfragen ein Token vom STS 🟣.&lt;br&gt;&lt;b&gt;Gateways (Port 8081/8082) werden dennoch komplett umgangen!&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.5;align=left;spacingLeft=10;fontSize=11;fontColor=#7c2d12;" vertex="1"><mxGeometry x="1260" y="410" width="370" height="105" as="geometry" /></mxCell><mxCell id="p2_e1" parent="1" value="&lt;b&gt;1. POST /token&lt;/b&gt;&lt;br&gt;(workstation-1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#374151;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_admin" target="p2_kc_rbac"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e2" parent="1" value="&lt;b&gt;2. M2M Token 🔴&lt;/b&gt;&lt;br&gt;(roles: [admin])" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;strokeColor=#6b7280;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_kc_rbac" target="p2_admin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e3" parent="1" value="&lt;b&gt;3. POST / DELETE Rule&lt;/b&gt;&lt;br&gt;Header: Bearer 🔴" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#374151;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_admin" target="p2_sec_sm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e4" parent="1" value="&lt;b&gt;4. Verify JWT&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;strokeColor=#6b7280;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_sec_sm" target="p2_kc_rbac"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e5" parent="1" value="&lt;b&gt;5. CRUD Rule&lt;/b&gt;&lt;br&gt;(in security-sm)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#374151;strokeWidth=1.5;startArrow=classic;startFill=1;endArrow=classic;endFill=1;" edge="1" source="p2_sec_sm" target="p2_mongo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e_setup" parent="1" value="Auto-Init on Boot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;strokeColor=#6b7280;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_setup_init" target="p2_sec_sm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e_sts_mint" parent="1" value="&lt;b&gt;A. Token Exchange / Mint&lt;/b&gt;&lt;br&gt;(Hole Provider Token 🟣)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;strokeColor=#6b7280;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_admin" target="p2_sts_prov"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e_aas_query" parent="1" value="&lt;b&gt;B. GET /shells/{id} (Direktzugriff)&lt;/b&gt;&lt;br&gt;Header: Authorization: Bearer 🟣 (KEIN GATEWAY!)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#374151;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_admin" target="p2_aas_env"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e_ui_query" parent="1" value="Web UI Query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;strokeColor=#6b7280;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_web_ui" target="p2_aas_env"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e_aas_verify" parent="1" value="&lt;b&gt;C. Verify JWT&lt;/b&gt;&lt;br&gt;(JWKS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;strokeColor=#6b7280;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_aas_env" target="p2_sts_prov"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e_aas_check" parent="1" value="&lt;b&gt;D. Check Dynamic Policy&lt;/b&gt;&lt;br&gt;(M2M Token von Keycloak RBAC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#374151;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="p2_aas_env" target="p2_sec_sm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_b1" parent="1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="415" y="195" width="24" height="24" as="geometry" /></mxCell><mxCell id="p2_b2" parent="1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="415" y="235" width="24" height="24" as="geometry" /></mxCell><mxCell id="p2_b3" parent="1" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="835" y="195" width="24" height="24" as="geometry" /></mxCell><mxCell id="p2_b4" parent="1" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="835" y="245" width="24" height="24" as="geometry" /></mxCell><mxCell id="p2_b5" parent="1" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="1280" y="215" width="24" height="24" as="geometry" /></mxCell><mxCell id="p2_bA" parent="1" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="415" y="430" width="24" height="24" as="geometry" /></mxCell><mxCell id="p2_bB" parent="1" value="B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="780" y="465" width="24" height="24" as="geometry" /></mxCell><mxCell id="p2_bC" parent="1" value="C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="755" y="420" width="24" height="24" as="geometry" /></mxCell><mxCell id="p2_bD" parent="1" value="D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="1010" y="370" width="24" height="24" as="geometry" /></mxCell><mxCell id="p2_leg_box" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#e5e7eb;strokeWidth=1;" vertex="1"><mxGeometry x="50" y="755" width="1650" height="85" as="geometry" /></mxCell><mxCell id="p2_leg_r_tok" parent="1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="70" y="770" width="20" height="20" as="geometry" /></mxCell><mxCell id="p2_leg_r_txt" parent="1" value="&lt;b&gt;Pfad A (Policy Management):&lt;/b&gt; M2M Token 🔴 von Keycloak RBAC (8085). 100% Intranet direkt zum Security Submodel (8086). &lt;u&gt;Kein STS, kein Gateway!&lt;/u&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;" vertex="1"><mxGeometry x="100" y="770" width="740" height="20" as="geometry" /></mxCell><mxCell id="p2_leg_p_tok" parent="1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;fontStyle=1;fontSize=11;" vertex="1"><mxGeometry x="70" y="805" width="20" height="20" as="geometry" /></mxCell><mxCell id="p2_leg_p_txt" parent="1" value="&lt;b&gt;Pfad B (AAS Datenabfrage):&lt;/b&gt; Provider Token 🟣 vom Provider STS (9051) nötig wegen Single-Issuer-Bindung der BaSyx AAS (8083). &lt;u&gt;Gateways (8081/8082) werden umgangen!&lt;/u&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;" vertex="1"><mxGeometry x="100" y="805" width="740" height="20" as="geometry" /></mxCell><mxCell id="p2_leg_gw_box" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=1.5;" vertex="1"><mxGeometry x="880" y="770" width="20" height="20" as="geometry" /></mxCell><mxCell id="p2_leg_gw_txt" parent="1" value="&lt;b&gt;Gateways (Consumer 8081 &amp;amp; Provider 8082):&lt;/b&gt; Werden bei internen Aufrufen &lt;u&gt;niemals&lt;/u&gt; aufgerufen! Es existieren direkte TCP/HTTP-Verbindungen." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#991b1b;fontStyle=1;" vertex="1"><mxGeometry x="910" y="770" width="780" height="20" as="geometry" /></mxCell><mxCell id="p2_leg_sum_txt" parent="1" value="&lt;b&gt;Erkenntnis für Masterarbeit:&lt;/b&gt; BaSyx trennt Policy Administration Point (Keycloak) von Policy Enforcement Point (STS-Issuer). In Multi-Issuer-Architekturen würde die AAS beiden vertrauen." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4b5563;fontStyle=2;" vertex="1"><mxGeometry x="880" y="805" width="810" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>