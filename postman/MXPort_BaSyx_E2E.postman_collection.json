    {
      "name": "04 - Gateway Hop & Dynamic RBAC",
      "item": [
        {
          "name": "4.1 Gateway End-to-End Hop Healthz",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{consumer_token}}"
              }
            ],
            "url": "{{consumer_gateway_url}}/external/provider-gateway/healthz"
          }
        },
        {
          "name": "4.2 Dynamic RBAC - Phase 1: Call AAS via Gateway (Pre-Rule: 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden before rule creation\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{consumer_token}}"
              }
            ],
            "url": "{{consumer_gateway_url}}/external/provider-gateway/shells/{{frame_shell_id}}"
          }
        },
        {
          "name": "4.3 Dynamic RBAC - Phase 2: Keycloak RBAC - Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.access_token).to.not.be.empty;",
                  "pm.collectionVariables.set(\"provider_admin_token\", jsonData.access_token);",
                  "if (pm.environment) { pm.environment.set(\"provider_admin_token\", jsonData.access_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Host",
                "value": "keycloak-rbac:8080"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "workstation-1",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "nY0mjyECF60DGzNmQUjL81XurSl8etom",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "openid",
                  "type": "text"
                }
              ]
            },
            "url": "{{keycloak_rbac_url}}"
          }
        },
        {
          "name": "4.4 Dynamic RBAC - Phase 3: Security Submodel - Inject Dynamic Rule",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rule created (201 Created or 409 Conflict)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{provider_admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"modelType\": \"SubmodelElementCollection\",\n  \"idShort\": \"{{frame_rule_id}}\",\n  \"value\": [\n    {\n      \"modelType\": \"Property\",\n      \"value\": \"{{role_name}}\",\n      \"idShort\": \"role\"\n    },\n    {\n      \"modelType\": \"SubmodelElementList\",\n      \"idShort\": \"action\",\n      \"orderRelevant\": true,\n      \"value\": [\n        {\n          \"modelType\": \"Property\",\n          \"value\": \"READ\"\n        }\n      ]\n    },\n    {\n      \"modelType\": \"SubmodelElementCollection\",\n      \"idShort\": \"targetInformation\",\n      \"value\": [\n        {\n          \"modelType\": \"SubmodelElementList\",\n          \"idShort\": \"aasIds\",\n          \"orderRelevant\": true,\n          \"value\": [\n            {\n              \"modelType\": \"Property\",\n              \"value\": \"https://example.com/ids/sm/5255_5191_9042_8127\"\n            }\n          ]\n        },\n        {\n          \"modelType\": \"Property\",\n          \"value\": \"aas\",\n          \"idShort\": \"@type\"\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": "{{security_submodel_url}}/{{security_submodel_id}}/submodel-elements"
          }
        },
        {
          "name": "4.5 Dynamic RBAC - Phase 4: Call AAS via Gateway (Post-Rule: 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK after rule creation\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.id).to.include(\"5255_5191_9042_8127\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{consumer_token}}"
              }
            ],
            "url": "{{consumer_gateway_url}}/external/provider-gateway/shells/{{frame_shell_id}}"
          }
        },
        {
          "name": "4.6 Dynamic RBAC - Phase 5: Security Submodel - Revoke Rule",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rule deleted (200 OK or 204 No Content)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{provider_admin_token}}"
              }
            ],
            "url": "{{security_submodel_url}}/{{security_submodel_id}}/submodel-elements/{{frame_rule_id}}"
          }
        },
        {
          "name": "4.7 Dynamic RBAC - Phase 6: Call AAS via Gateway (Post-Revocation: 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code reverts to 403 Forbidden after revocation\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{consumer_token}}"
              }
            ],
            "url": "{{consumer_gateway_url}}/external/provider-gateway/shells/{{frame_shell_id}}"
          }
        }
      ]
    }
  ]
}