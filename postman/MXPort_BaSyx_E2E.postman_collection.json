  "item": [
    {
      "name": "01 - Company Lookup & Service Discovery",
      "item": [
        {
          "name": "1.1 List All Seeded Companies",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Seeded companies returned\", function () {",
                  "    pm.expect(jsonData.result).to.be.an(\"array\");",
                  "    pm.expect(jsonData.result.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{company_lookup_url}}/companies?limit=10"
          }
        },
        {
          "name": "1.2 Search Company by Name (Factory-X)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Factory-X found by base64 name\", function () {",
                  "    pm.expect(jsonData.result).to.be.an(\"array\");",
                  "    pm.expect(jsonData.result.length).to.be.above(0);",
                  "    pm.expect(jsonData.result[0].name).to.eql(\"Factory-X\");",
                  "    pm.expect(jsonData.result[0].domain).to.eql(\"factory-x.org\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{company_lookup_url}}/companies?name={{sample_company_name_b64}}"
          }
        },
        {
          "name": "1.3 Get Company by Domain (Factory-X)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Factory-X details match\", function () {",
                  "    pm.expect(jsonData.result.name).to.eql(\"Factory-X\");",
                  "    pm.expect(jsonData.result.domain).to.eql(\"factory-x.org\");",
                  "    pm.expect(jsonData.result.endpoints.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{company_lookup_url}}/companies/{{sample_company_domain_b64}}"
          }
        },
        {
          "name": "1.4 Register Demo Company Endpoint (Auth with API Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Demo company created (201 Created or 200 OK)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Company domain is provider.mxport.local\", function () {",
                  "    pm.expect(jsonData.domain).to.eql(\"provider.mxport.local\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{company_lookup_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Provider AAS Demo\",\n  \"domain\": \"provider.mxport.local\",\n  \"endpoints\": [\n    {\n      \"protocolInformation\": {\n        \"href\": \"{{provider_gateway_url}}\",\n        \"endpointProtocol\": \"HTTP\",\n        \"endpointProtocolVersion\": [\"1.1\"]\n      },\n      \"interface\": \"AAS-REPOSITORY-3.1\"\n    }\n  ]\n}"
            },
            "url": "{{company_lookup_url}}/companies"
          }
        },
        {
          "name": "1.5 Verify Registered Demo Company",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Registered demo company returned\", function () {",
                  "    pm.expect(jsonData.result.domain).to.eql(\"provider.mxport.local\");",
                  "    pm.expect(jsonData.result.endpoints[0].interface).to.eql(\"AAS-REPOSITORY-3.1\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{company_lookup_url}}/companies/{{demo_company_domain_b64}}"
          }
        },
        {
          "name": "1.6 Cleanup / Delete Demo Company (Auth with API Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Demo company deleted (204 No Content or 200 OK)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{company_lookup_api_key}}"
              }
            ],
            "url": "{{company_lookup_url}}/companies/{{demo_company_domain_b64}}"
          }
        }
      ]
    },
