# =============================================================================
# MX-Port Leo – Scenario Environment File
#
# Copy this file to .env and fill in all values marked with <CHANGE_ME>.
# All variables are consumed by docker-compose.yml via ${VAR} substitution.
#
# Sections:
#   1. Consumer – Keycloak (Identity Provider)
#   2. Consumer – STS (Security Token Service)
#   3. Consumer – Gateway (OpenResty)
#   4. Provider – STS (Security Token Service)
#   5. Provider – Gateway (OpenResty)
#   6. Provider – AAS (Asset Administration Shell, stub)
#   7. Company Lookup Service
# =============================================================================


# ── 1. Consumer – Keycloak ────────────────────────────────────────────────────

# Admin credentials for the Keycloak management console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME>

# Realm that issues Consumer tokens (must match server-config issuer URLs)
KEYCLOAK_REALM=mxport

# Host port exposed on the Docker host
KEYCLOAK_PORT=8080


# ── 2. Consumer – STS ─────────────────────────────────────────────────────────

# Host port for the Consumer STS REST API
CONSUMER_STS_PORT=9050

# Set to "true" to enable Trusted Partner List validation (requires trusted-list files)
CONSUMER_STS_TRUSTED_LIST_ENABLE=false


# ── 3. Consumer – Gateway ─────────────────────────────────────────────────────

# Host port exposed for the Consumer Gateway
CONSUMER_GATEWAY_PORT=8081


# ── 4. Provider – STS ─────────────────────────────────────────────────────────

# Host port for the Provider STS REST API (different from Consumer STS)
PROVIDER_STS_PORT=9051

# Set to "true" to enable Trusted Partner List validation
PROVIDER_STS_TRUSTED_LIST_ENABLE=false


# ── 5. Provider – Gateway ─────────────────────────────────────────────────────

# Host port exposed for the Provider Gateway
PROVIDER_GATEWAY_PORT=8082


# ── 6. Provider – AAS (stub) ─────────────────────────────────────────────────

# Host port for the Provider AAS stub (traefik/whoami or BaSyx)
PROVIDER_AAS_PORT=8083


# ── 7. Company Lookup ─────────────────────────────────────────────────────────

# API keys for write access (comma-separated); leave empty for read-only
COMPANY_LOOKUP_API_KEYS=<CHANGE_ME>

# CORS allowed origins (* = any, restrict in production)
COMPANY_LOOKUP_CORS_ORIGINS=*

# Host port for the Company Lookup API
COMPANY_LOOKUP_PORT=50102

# Initial admin API key for write operations (create/update/delete companies)
COMPANY_LOOKUP_ADMIN_KEY=<CHANGE_ME>

# PostgreSQL credentials
POSTGRES_USER=company
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=company_lookup
POSTGRES_PORT=5432


# ── 8. Provider – BaSyx Dynamic RBAC & AAS Web UI ───────────────────────────

# Host port for Provider Keycloak RBAC (Realm: BaSyx)
RBAC_KEYCLOAK_PORT=8085

# Host port for Security Submodel Repository
SECURITY_SM_PORT=8086

# Host port for BaSyx AAS Web UI (Vue.js frontend)
AAS_WEB_UI_PORT=3000

# Enable Keycloak authentication in AAS Web UI (false = open browser viewer)
AAS_GUI_KEYCLOAK_ACTIVE=false

