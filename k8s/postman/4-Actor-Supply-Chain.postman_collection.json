    },
    {
      "name": "5 - Boundary Enforcement (Negative Tests)",
      "item": [
        {
          "name": "Bypass: OEM calls Tier 3 Directly (Must Fail 401)",
          "request": {
            "method": "GET",
            "url": "{{tier3_gw}}/shells",
            "header": [{ "key": "Authorization", "value": "Bearer {{oem_token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OEM bypass to Tier 3 rejected with 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Bypass: OEM calls Tier 2 Directly (Must Fail 401)",
          "request": {
            "method": "GET",
            "url": "{{tier2_gw}}/shells",
            "header": [{ "key": "Authorization", "value": "Bearer {{oem_token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OEM bypass to Tier 2 rejected with 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Bypass: Tier 1 calls Tier 3 Directly (Must Fail 401)",
          "request": {
            "method": "GET",
            "url": "{{tier3_gw}}/shells",
            "header": [{ "key": "Authorization", "value": "Bearer {{tier1_token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Tier 1 bypass to Tier 3 rejected with 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Unauthenticated Call to Tier 1 (Must Fail 401)",
          "request": {
            "method": "GET",
            "url": "{{tier1_gw}}/shells"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthenticated call rejected with 401', function () { pm.response.to.have.status(401); });"
                ],
