{
  "info": {
    "_postman_id": "c7a8b9e0-1f2a-3b4c-5d6e-7f8a9b0c1d2e",
    "name": "6-Actor Industrial Dataspace Verification",
    "description": "Comprehensive E2E Test Suite for the 6-Actor Industrial Dataspace in k3d:\n- Actors A, B, C: Public AAS Repos (Servo Motor, Gearbox, Sensor)\n- Actor D: Machine Manufacturer, compares A/B/C data, protects Simulation SM (Keycloak + SecSM)\n- Actor E: Production Plant, buys machine from D (receives Simulation SM), logs TimeSeries SM, restricts TimeSeries to verified customers while Nameplate is visible to others\n- Actor F: Customer of E, verifies access to TimeSeries SM",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "keycloak_base", "value": "http://keycloak.localhost" },
    { "key": "lookup_base", "value": "http://lookup.localhost/api/v2" },
    { "key": "actor_a_gw", "value": "" },
    { "key": "actor_b_gw", "value": "" },
