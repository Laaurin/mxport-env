    {
      "name": "3 - Actor D Machine Manufacturer & Simulation Protection",
      "item": [
        {
          "name": "Actor D - Negative: Unauthenticated Query to Simulation Submodel (Must be 401)",
          "request": {
            "method": "GET",
            "url": "{{actor_d_gw}}/submodels/dXJuOmRhdGFzcGFjZTpkOnNtOm1hY2hpbmUtc2ltdWxhdGlvbg=="
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actor D - Negative: Non-Customer (Actor F) Query to Simulation SM (Must be 401 or 403)",
          "request": {
            "method": "GET",
            "url": "{{actor_d_gw}}/submodels/dXJuOmRhdGFzcGFjZTpkOnNtOm1hY2hpbmUtc2ltdWxhdGlvbg==",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_f}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Access Denied for Non-Customer Actor F (HTTP 401 or 403)', function () { pm.expect([401, 403]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actor D - Authorized Customer E queries Machine Type Shells",
          "request": {
            "method": "GET",
            "url": "{{actor_d_gw}}/shells",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_e}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var raw = JSON.stringify(pm.response.json());",
                  "pm.expect(raw).to.include('MillingMachineTypeAAS');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actor D - Authorized Customer E queries TechnicalData (Integrated A, B, C)",
          "request": {
            "method": "GET",
            "url": "{{actor_d_gw}}/submodels/dXJuOmRhdGFzcGFjZTpkOnNtOnRlY2huaWNhbC1kYXRh",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_e}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var raw = JSON.stringify(pm.response.json());",
                  "pm.expect(raw).to.include('IntegratedMotorRef');",
                  "pm.expect(raw).to.include('IntegratedGearboxRef');",
                  "pm.expect(raw).to.include('IntegratedSensorRef');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actor D - Authorized Customer E queries Simulation Submodel (200 OK + STS JWT Headers)",
          "request": {
            "method": "GET",
            "url": "{{actor_d_gw}}/submodels/dXJuOmRhdGFzcGFjZTpkOnNtOm1hY2hpbmUtc2ltdWxhdGlvbg==",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_e}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Exposes X-Dataspace-Source-Token & X-Dataspace-Exchanged-Token headers', function () {",
                  "  pm.response.to.have.header('X-Dataspace-Source-Token');",
                  "  pm.response.to.have.header('X-Dataspace-Exchanged-Token');",
                  "});",
                  "var raw = JSON.stringify(pm.response.json());",
                  "pm.expect(raw).to.include('KinematicAndThermalFEA');",
                  "pm.expect(raw).to.include('ToolCenterPointPrecisionMicron');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
