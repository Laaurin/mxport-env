{
  "id": "tier1",
  "realm": "tier1",
  "displayName": "Tier 1 Battery Pack Supplier",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "partner-tier1",
        "description": "Tier 1 Partner Role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "tier1-client",
      "name": "Tier 1 Client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "tier1-secret-12345",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "defaultClientScopes": ["basic", "openid", "profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-tier1-client",
      "enabled": true,
      "serviceAccountClientId": "tier1-client",
      "realmRoles": ["partner-tier1"]
    },
    {
      "username": "tier1-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tier1",
      "lastName": "User",
      "email": "tier1@dataspace.local",
      "realmRoles": ["partner-tier1"],
      "credentials": [
        {
          "type": "password",
          "value": "tier1-pass",
          "temporary": false
        }
      ]
    }
  ]
}
