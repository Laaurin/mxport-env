{
  "id": "tier2",
  "realm": "tier2",
  "displayName": "Tier 2 Module Supplier",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "partner-tier2",
        "description": "Tier 2 Partner Role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "tier2-client",
      "name": "Tier 2 Client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "tier2-secret-12345",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "defaultClientScopes": ["basic", "openid", "profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-tier2-client",
      "enabled": true,
      "serviceAccountClientId": "tier2-client",
      "realmRoles": ["partner-tier2"]
    },
    {
      "username": "tier2-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tier2",
      "lastName": "User",
      "email": "tier2@dataspace.local",
      "realmRoles": ["partner-tier2"],
      "credentials": [
        {
          "type": "password",
          "value": "tier2-pass",
          "temporary": false
        }
      ]
    }
  ]
}
